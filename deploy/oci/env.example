# Optional PULSE_ENV GitHub secret: extra/overriding settings appended after deploy/oci/public.env.
# DATABASE_URL, REDIS_URL, FERNET_KEYS, POSTGRES_PASSWORD and API_DOMAIN are generated for you.
# Needed only if the Supabase project signs tokens with the legacy HS256 secret:
SUPABASE_JWT_SECRET=
# Later, for Gmail statement import:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: file beta bug reports from the app as GitHub issues (POST /v1/bug-reports). Free.
# A fine-grained token for ONE repository (ideally private), permissions: Issues read+write, Contents read+write.
BUG_REPORT_REPO=
BUG_REPORT_GITHUB_TOKEN=
# Optional: fixed signing key for /v1/config and /v1/packs (base64 of a 32-byte seed). Default: derived from the
# server's Fernet key, which is stable. Print the matching public key with scripts/content.py pubkey.
CONFIG_SIGNING_KEY=
