# Copy to /opt/pulse/.env on the VM (chmod 600). Never commit the filled-in file.
# Free HTTPS hostname without buying a domain: <public-ip-with-dashes>.sslip.io, e.g. 129-146-1-2.sslip.io
API_DOMAIN=129-146-1-2.sslip.io

# Supabase: transaction pooler (6543) for the API, session pooler (5432) for migrations.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_PGBOUNCER=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
FERNET_KEYS=
CORS_ORIGINS=http://localhost:3000

# Statement PDFs live on the VM disk (persistent volume) unless you switch to Supabase Storage.
STORAGE_BACKEND=local

# Later, for Gmail statement import:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://129-146-1-2.sslip.io/v1/email-connections/gmail/callback
