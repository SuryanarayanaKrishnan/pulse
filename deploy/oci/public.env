# Non-secret production settings, committed. Secrets (JWT secret, OAuth client secret) go in the PULSE_ENV GitHub secret.
APP_ENV=production
LOG_JSON=true
STORAGE_BACKEND=local
CORS_ORIGINS=http://localhost:3000
SUPABASE_JWT_AUDIENCE=authenticated
# Fill from the Supabase project (asymmetric signing keys): https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
