# --- App ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database (Supabase Postgres) ---
# Plain postgresql:// URLs are accepted and rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulse
# Set true when using the Supabase transaction pooler (port 6543 / pgbouncer)
DB_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Redis (arq) ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase auth ---
# Use the project's JWT secret (Settings > API > JWT Secret) for HS256 projects,
# and/or the JWKS URL for projects on asymmetric signing keys.
SUPABASE_JWT_SECRET=change-me-to-your-supabase-jwt-secret-at-least-32-chars
SUPABASE_JWKS_URL=             # e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=           # optional, e.g. https://<ref>.supabase.co/auth/v1

# --- Encryption ---
# Comma separated Fernet keys; first encrypts, all decrypt (rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=

# --- File storage (statement PDFs) ---
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_DIR=./var/storage
# Supabase Storage S3 credentials (Project settings > Storage > S3 connection)
S3_ENDPOINT_URL=               # https://<ref>.supabase.co/storage/v1/s3
S3_BUCKET=statements
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=15728640

# --- Gmail statement ingestion (OAuth 2.0, scope gmail.readonly) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=           # e.g. https://api.example.com/v1/email-connections/gmail/callback
OAUTH_SUCCESS_REDIRECT=        # app deep link / page to send the browser to after consent
OAUTH_STATE_SECRET=            # optional; defaults to the first FERNET key
GMAIL_INITIAL_LOOKBACK_DAYS=180
